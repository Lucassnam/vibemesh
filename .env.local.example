# Copy this file to .env.local and fill in your values

# Supabase — get from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — NEVER expose this client-side
# Used only in API route handlers and the test agent's scan simulation
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket names
NEXT_PUBLIC_PREVIEW_BUCKET=previews
APP_ZIP_BUCKET=app-zips

# Optional: override base URL for test agent (default: http://localhost:3000)
# BASE_URL=http://localhost:3000
